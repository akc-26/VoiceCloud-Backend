{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@/*": ["src/*"],
      "@shared": ["shared/index.ts"],
      "@shared/*": ["shared/*"],
      "@shared/api": ["shared/api/index.ts"],
      "@shared/contracts": ["shared/contracts/index.ts"],
      "@shared/dto": ["shared/dto/index.ts"],
      "@shared/enums": ["shared/enums/index.ts"],
      "@shared/constants": ["shared/constants/index.ts"],
      "@shared/permissions": ["shared/permissions/index.ts"],
      "@shared/validators": ["shared/validators/index.ts"],
      "@shared/utils": ["shared/utils/index.ts"],
      "@shared/config": ["shared/config/index.ts"],
      "@shared/theme": ["shared/theme/index.ts"],
      "@shared/branding": ["shared/branding/index.ts"]
    }
  },
  "include": ["src/**/*", "shared/**/*"],
  "exclude": ["node_modules", "dist", "admin", "creator", "website"]
}
