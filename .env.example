# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Streaming key entropy remains environment-owned. Streaming provider,
# endpoints, bitrate, codec, region, recording, and latency policies are
# database-backed and managed through Admin System Settings.
STREAM_KEY_LENGTH=32

# Private Storage Configuration
PRIVATE_STORAGE_PATH="private_uploads"
HOST_GOVERNMENT_ID_MAX_SIZE=10485760
HOST_SELFIE_MAX_SIZE=5242880
HOST_SUPPORTING_DOCUMENT_MAX_SIZE=20971520


# Local development account bootstrap (ignored when NODE_ENV=production).
# Set DEV_SEED_ACCOUNTS=false to disable all local development accounts.
DEV_SEED_ACCOUNTS=true
DEV_ADMIN_EMAIL="admin@voicecloud.com"
DEV_ADMIN_USERNAME="voicecloud_admin"
DEV_ADMIN_PASSWORD="AdminPass123!"
DEV_CREATOR_EMAIL="creator@voicecloud.com"
DEV_CREATOR_USERNAME="voicecloud_creator"
DEV_CREATOR_PASSWORD="CreatorPass123!"

# WP08 infrastructure selection
# auto: attempt real PostgreSQL/Redis, then visibly fall back in development
# real: fail startup unless real PostgreSQL and Redis are reachable
# memory: explicit development/test fallback; forbidden in production
INFRASTRUCTURE_MODE="auto"
INFRASTRUCTURE_CONNECT_TIMEOUT_MS=3000

# PostgreSQL
DATABASE_HOST="localhost"
DATABASE_PORT=5432
DATABASE_NAME="voicecloud"
DATABASE_USER="postgres"
DATABASE_PASSWORD="postgres"
# Keep false for normal and production execution. WP08's isolated local
# acceptance database enables this temporarily through its checker only.
DATABASE_SYNCHRONIZE=false

# Redis / Memurai
REDIS_HOST="localhost"
REDIS_PORT=6379
