# VoiceCloud production environment template
# Copy this file to .env on the deployment host and replace every CHANGE_ME value.

NODE_ENV=production
PORT=3000
ENABLE_SWAGGER=false

# Application security
JWT_SECRET="CHANGE_ME_USE_A_LONG_RANDOM_SECRET"
ENCRYPTION_KEY="CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_SECRET"

# Infrastructure
# Production must use real PostgreSQL and Redis services.
INFRASTRUCTURE_MODE=real
INFRASTRUCTURE_CONNECT_TIMEOUT_MS=3000

# PostgreSQL
# Use 127.0.0.1 rather than localhost when services run on the same Raspberry Pi,
# because the current production validator rejects the literal value localhost.
DATABASE_HOST="127.0.0.1"
DATABASE_PORT=5432
DATABASE_NAME="voicecloud"
DATABASE_USER="voicecloud"
DATABASE_PASSWORD="CHANGE_ME_DATABASE_PASSWORD"
# Keep false. Fresh installations use `npm run database:bootstrap:prod`.
DATABASE_SYNCHRONIZE=false

# Redis
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# Storage
STORAGE_DRIVER=local
PRIVATE_STORAGE_PATH="/var/lib/voicecloud/private_uploads"
HOST_GOVERNMENT_ID_MAX_SIZE=10485760
HOST_SELFIE_MAX_SIZE=5242880
HOST_SUPPORTING_DOCUMENT_MAX_SIZE=20971520

# Streaming
STREAM_KEY_LENGTH=32

# Optional Firebase Cloud Messaging
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
# GOOGLE_APPLICATION_CREDENTIALS="/etc/voicecloud/firebase-service-account.json"

# Optional Gemini provider connectivity testing
# GEMINI_API_KEY="your-gemini-api-key"

# Optional S3-compatible storage credentials when an S3 provider is selected
# AWS_S3_BUCKET="voicecloud-media"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"

# Development bootstrap accounts are disabled in the production template.
DEV_SEED_ACCOUNTS=false

# WP09 backup import hard limit (bytes, default 256 MiB)
BACKUP_UPLOAD_MAX_SIZE=268435456

# WP09 API abuse protection
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20
