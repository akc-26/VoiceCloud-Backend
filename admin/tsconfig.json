{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared": ["../shared/index.ts"],
      "@shared/*": ["../shared/*"],
      "@shared/api": ["../shared/api/index.ts"],
      "@shared/contracts": ["../shared/contracts/index.ts"],
      "@shared/dto": ["../shared/dto/index.ts"],
      "@shared/enums": ["../shared/enums/index.ts"],
      "@shared/constants": ["../shared/constants/index.ts"],
      "@shared/permissions": ["../shared/permissions/index.ts"],
      "@shared/validators": ["../shared/validators/index.ts"],
      "@shared/utils": ["../shared/utils/index.ts"],
      "@shared/config": ["../shared/config/index.ts"],
      "@shared/theme": ["../shared/theme/index.ts"]
    }
  },
  "include": ["src"]
}
